generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  USUARIO
  RESPONSAVEL
  ADMINISTRADOR
}

enum StatusObjeto {
  PERDIDO
  ENCONTRADO
  DEVOLVIDO
}

enum TipoLocalizacao {
  CAMPUS
  PREDIO
  ANDAR
  SALA
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  papel Papel  @default(USUARIO)

  perfil             Perfil?
  objetosRegistrados Objeto[]
  retiradasEntregues Retirada[]

  @@map("usuarios")
}

model Perfil {
  id        Int     @id @default(autoincrement())
  telefone  String?
  matricula String?
  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("perfis")
}

model Localizacao {
  id      Int             @id @default(autoincrement())
  nome    String
  tipo    TipoLocalizacao
  paiId   Int?
  pai     Localizacao?    @relation("Hierarquia", fields: [paiId], references: [id])
  filhos  Localizacao[]   @relation("Hierarquia")
  objetos Objeto[]

  @@map("localizacoes")
}

model Categoria {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  objetos Objeto[]

  @@map("categorias")
}

model Tag {
  id      Int      @id @default(autoincrement())
  nome    String   @unique
  objetos Objeto[]

  @@map("tags")
}

model Objeto {
  id             Int          @id @default(autoincrement())
  tipo           String
  descricao      String
  dataOcorrencia DateTime
  contato        String?
  status         StatusObjeto
  sensivel       Boolean      @default(false)
  criadoEm       DateTime     @default(now())

  categoriaId     Int
  localizacaoId   Int
  registradoPorId Int
  categoria       Categoria   @relation(fields: [categoriaId], references: [id])
  localizacao     Localizacao @relation(fields: [localizacaoId], references: [id])
  registradoPor   Usuario     @relation(fields: [registradoPorId], references: [id])

  tags     Tag[]
  fotos    Foto[]
  retirada Retirada?

  @@map("objetos")
}

model Foto {
  id       Int    @id @default(autoincrement())
  url      String
  objetoId Int
  objeto   Objeto @relation(fields: [objetoId], references: [id], onDelete: Cascade)

  @@map("fotos")
}

model Retirada {
  id                   Int      @id @default(autoincrement())
  retiradoPorNome      String
  retiradoPorDocumento String?
  dataRetirada         DateTime @default(now())

  objetoId      Int     @unique
  responsavelId Int
  objeto        Objeto  @relation(fields: [objetoId], references: [id])
  responsavel   Usuario @relation(fields: [responsavelId], references: [id])

  @@map("retiradas")
}
